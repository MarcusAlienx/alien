{
  "hosting": {
    "public": "dist/client",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": ".",
    "ignore": [
      "client/**",
      "node_modules/**",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
